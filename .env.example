# ============================================
# Nexus Repository Manager — Environment Configuration
# ============================================
# Copy this file to .env and update values for your environment.
# All settings can be overridden via environment variables.
#
# Deployment models supported:
#   Standalone:       SQLite + File BlobStore       (default settings below)
#   Clustered:        PostgreSQL + Shared Filesystem (update DATABASE_URL)
#   Container-Native: PostgreSQL + S3 BlobStore      (update DATABASE_URL + BLOBSTORE_TYPE)
#
# See also:
#   config/default.yaml       — Full default configuration reference
#   config/development.yaml   — Development environment overrides
#   config/production.yaml    — Production environment settings
#   config/testing.yaml       — Test environment configuration
#   gunicorn.conf.py          — Production WSGI server settings
#   docker-compose.yml        — Multi-service development stack
# ============================================

# -----------------------------------------------------------
# Application Settings
# -----------------------------------------------------------
# FLASK_APP:  Application factory entry point for Flask CLI and Gunicorn.
# FLASK_ENV:  Runtime environment (development | production | testing).
#             Controls debug mode, configuration file selection, and logging verbosity.
# SECRET_KEY: Cryptographic key for session cookie signing and CSRF protection.
#             MUST be changed to a unique random value in every deployment.
# DEBUG:      Enable Flask debug mode (true | false). NEVER enable in production.
FLASK_APP=src.app:create_app
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=true

# -----------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------
# Dual-persistence architecture: the DataStore holds all relational
# metadata (repositories, components, assets, users, roles, privileges,
# content selectors, tasks, system config, audit events).
#
# Supported connection strings:
#   Standalone (default):    sqlite:///nexus.db
#   Clustered / Production:  postgresql://user:pass@host:5432/nexus
#
# The connection pool is managed by SQLAlchemy's QueuePool (PostgreSQL)
# or NullPool (SQLite).
DATABASE_URL=sqlite:///nexus.db

# -----------------------------------------------------------
# BlobStore Configuration
# -----------------------------------------------------------
# The BlobStore holds all binary artifact content, separate from metadata.
# Two backends are supported:
#   file: Content-addressable filesystem storage with soft-delete (F-201)
#   s3:   Amazon S3 storage with server-side encryption (F-202)
BLOBSTORE_TYPE=file
BLOBSTORE_PATH=./data/blobs

# -----------------------------------------------------------
# S3 BlobStore Settings (when BLOBSTORE_TYPE=s3)
# -----------------------------------------------------------
# Required only for container-native and cloud deployments.
# Authentication order: IAM role → instance profile → explicit keys.
# Leave S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY empty to use IAM roles.
#
# S3_ENCRYPTION: Server-side encryption mode.
#   SSE-S3:  Amazon S3-managed keys (default, no KMS key required)
#   SSE-KMS: AWS KMS customer-managed key (set S3_KMS_KEY_ARN)
# S3_KMS_KEY_ARN: KMS key ARN for SSE-KMS encryption (leave empty for SSE-S3).
# S3_PREFIX: Optional key prefix for all objects within the bucket.
S3_BUCKET=nexus-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENCRYPTION=SSE-S3
S3_KMS_KEY_ARN=
S3_PREFIX=

# -----------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------
# JWT tokens are used for API session management and cookie-based auth.
# Replaces the Java-JWT (auth0) 4.4.0 token handling from the original
# Java implementation.
#
# JWT_SECRET:           Signing key for HS256, or path to private key for RS256.
#                       MUST be changed to a unique random value in every deployment.
# JWT_ALGORITHM:        Signing algorithm (HS256 | RS256).
# JWT_EXPIRATION_HOURS: Token lifetime in hours before re-authentication is required.
JWT_SECRET=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# -----------------------------------------------------------
# LDAP Configuration (optional)
# -----------------------------------------------------------
# Configure to enable LDAP/Active Directory authentication realm.
# Part of the multi-realm auth chain: Local → Bearer → JWT → LDAP → SAML/OIDC.
# Connections use TLS by default (LDAP_USE_TLS=true).
#
# LDAP_URL:                LDAP server URI (e.g., ldap://ldap.example.com:389
#                          or ldaps://ldap.example.com:636).
# LDAP_BASE_DN:            Base distinguished name for user searches.
# LDAP_USER_SEARCH_FILTER: LDAP filter template; {0} is replaced with the username.
# LDAP_BIND_DN:            DN for the service account used to search for users.
# LDAP_BIND_PASSWORD:      Password for the LDAP service account bind.
# LDAP_USE_TLS:            Enforce TLS for LDAP connections (true | false).
# LDAP_GROUP_BASE_DN:      Base DN for group searches (role mapping).
# LDAP_GROUP_SEARCH_FILTER:Filter template for resolving group memberships.
LDAP_URL=
LDAP_BASE_DN=
LDAP_USER_SEARCH_FILTER=(uid={0})
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USE_TLS=true
LDAP_GROUP_BASE_DN=
LDAP_GROUP_SEARCH_FILTER=

# -----------------------------------------------------------
# SAML/OIDC Configuration (optional)
# -----------------------------------------------------------
# Configure to enable SAML or OpenID Connect SSO authentication realm.
# Part of the multi-realm auth chain: Local → Bearer → JWT → LDAP → SAML/OIDC.
#
# SAML_IDP_METADATA_URL: URL to the SAML Identity Provider metadata XML.
# OIDC_CLIENT_ID:        OAuth 2.0 client identifier for the OIDC provider.
# OIDC_CLIENT_SECRET:    OAuth 2.0 client secret (keep empty in .env, set at runtime).
# OIDC_DISCOVERY_URL:    OIDC well-known configuration endpoint
#                        (e.g., https://idp.example.com/.well-known/openid-configuration).
SAML_IDP_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=

# -----------------------------------------------------------
# Scheduler Settings
# -----------------------------------------------------------
# APScheduler 3.11.2 with BackgroundScheduler replaces Quartz 2.3.2.
# Manages cleanup policies (F-204), BlobStore maintenance (F-203),
# proxy cache invalidation, and periodic health checks.
#
# SCHEDULER_ENABLED:      Enable/disable the background task scheduler (true | false).
# SCHEDULER_JOBSTORE_URL: Optional database URL for persistent job store.
#                         Defaults to the main DATABASE_URL if empty.
#                         Required for clustered deployments to prevent duplicate execution.
SCHEDULER_ENABLED=true
SCHEDULER_JOBSTORE_URL=

# -----------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------
# Content indexing and full-text search (F-103) for component discovery.
# Two backends are supported:
#   whoosh:        Pure-Python search engine (default, standalone deployments)
#   elasticsearch: Elasticsearch 8.x cluster (production deployments)
#
# SEARCH_BACKEND:     Search engine to use (whoosh | elasticsearch).
# ELASTICSEARCH_URL:  Elasticsearch cluster URL (when SEARCH_BACKEND=elasticsearch).
# WHOOSH_INDEX_PATH:  Path to Whoosh index directory (when SEARCH_BACKEND=whoosh).
SEARCH_BACKEND=whoosh
ELASTICSEARCH_URL=http://localhost:9200
WHOOSH_INDEX_PATH=./data/search

# -----------------------------------------------------------
# Metrics and Observability
# -----------------------------------------------------------
# Prometheus-compatible metrics exposed at /service/metrics endpoint.
# Replaces Dropwizard Metrics 4.2.25 + Prometheus 0.16.0 from the
# original Java implementation.
#
# METRICS_ENABLED: Enable/disable Prometheus metric collection (true | false).
METRICS_ENABLED=true

# -----------------------------------------------------------
# Logging
# -----------------------------------------------------------
# Structured JSON logging compatible with external SIEM ingestion.
# Log entries include timestamp, level, module, message, and contextual
# attributes (request_id, user_id where applicable).
#
# LOG_LEVEL:  Minimum log level (DEBUG | INFO | WARNING | ERROR | CRITICAL).
# LOG_FORMAT: Output format (json | text). Use json for production and SIEM integration.
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------
# Gunicorn Settings (production WSGI server)
# -----------------------------------------------------------
# Gunicorn 23.0.0 replaces Jetty 12.0.5 as the HTTP server.
# These variables override settings in gunicorn.conf.py.
# See gunicorn.conf.py for the full list of tunables.
#
# GUNICORN_BIND:     Listen address and port (default: 0.0.0.0:8081).
# GUNICORN_WORKERS:  Number of worker processes (default: min(4, cpu*2+1)).
#                    Match to container CPU allocation for container-native deployments.
# GUNICORN_TIMEOUT:  Worker silent timeout in seconds (default: 120).
#                    Set high enough for large artifact transfers.
# GUNICORN_WORKER_CLASS: Worker type (sync | gthread | gevent | eventlet).
# GUNICORN_THREADS:  Threads per worker for gthread worker class.
# GUNICORN_GRACEFUL_TIMEOUT: Graceful shutdown timeout in seconds (default: 30).
# GUNICORN_KEEPALIVE: Keep-alive duration for idle connections in seconds.
# GUNICORN_ACCESS_LOG: Access log destination ("-" for stdout, or a file path).
# GUNICORN_ERROR_LOG:  Error log destination ("-" for stderr, or a file path).
# GUNICORN_LOG_LEVEL:  Gunicorn internal log level (debug | info | warning | error | critical).
GUNICORN_BIND=0.0.0.0:8081
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# -----------------------------------------------------------
# SSL/TLS
# -----------------------------------------------------------
# SSL/TLS certificate lifecycle management (F-302).
# SSL is typically terminated at a reverse proxy (Nginx, HAProxy, ALB)
# in production. Direct SSL termination at Gunicorn is supported for
# standalone deployments.
#
# SSL_CERT_PATH:    Path to PEM-encoded SSL certificate file.
# SSL_KEY_PATH:     Path to PEM-encoded SSL private key file.
# TRUSTSTORE_PATH:  Path to custom CA trust store (PEM bundle) for
#                   verifying upstream proxy repository connections and
#                   LDAP server certificates.
SSL_CERT_PATH=
SSL_KEY_PATH=
TRUSTSTORE_PATH=

# -----------------------------------------------------------
# SIEM Integration (audit log forwarding)
# -----------------------------------------------------------
# Audit logging (F-303) with JSON-serialized event capture.
# Configure to forward audit events to an external SIEM endpoint
# for centralized security event monitoring and compliance.
#
# SIEM_ENDPOINT: URL of the SIEM ingestion endpoint (e.g., https://siem.example.com/api/events).
# SIEM_TOKEN:    Authentication token for the SIEM endpoint.
SIEM_ENDPOINT=
SIEM_TOKEN=

# -----------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------
# Webhook event notifications (F-503) with HMAC-SHA256 signing.
# Global settings for the webhook dispatcher.
#
# WEBHOOK_SECRET: Default HMAC signing key for webhook payloads.
#                 Individual webhooks can override this with their own secret.
# WEBHOOK_TIMEOUT: HTTP request timeout in seconds for webhook delivery.
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=30

# -----------------------------------------------------------
# Scripting Engine
# -----------------------------------------------------------
# Server-side scripting engine (F-502) for sandboxed Python execution.
#
# SCRIPTING_ENABLED: Enable/disable the scripting engine (true | false).
SCRIPTING_ENABLED=true
