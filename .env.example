# =============================================================================
# Sonatype Nexus Repository - Flask Application Configuration
# =============================================================================
#
# Environment variable template for the Nexus Repository Flask application.
# This follows the twelve-factor app methodology for configuration management.
#
# Usage:
#   1. Copy this file to .env:       cp .env.example .env
#   2. Edit .env with your values:   nano .env
#   3. The application loads .env automatically via python-dotenv.
#
# IMPORTANT: Never commit .env to version control. Only .env.example is tracked.
#
# All variables listed here are read by config/default.py and propagated through
# the Flask application context. Environment-specific config classes
# (development, production, testing) inherit from DefaultConfig and may override
# these defaults.
# =============================================================================


# =============================================================================
# Flask Application Settings
# =============================================================================

# Flask session encryption key. MUST be changed in production to a random value.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Configuration profile to load: development, production, testing, or default.
# Maps to config classes in config/__init__.py via config_dict.
FLASK_CONFIG=development

# Enable Flask debug mode with auto-reloader. Set to False in production.
FLASK_DEBUG=True


# =============================================================================
# Database Configuration
# Replaces: MyBatis 3.5.15 (ORM) + HikariCP 4.0.3 (connection pool)
# Dual-database architecture: SQLite for standalone / PostgreSQL for clustered
# =============================================================================

# Default: SQLite for standalone deployments (replaces H2 2.3.232)
DATABASE_URL=sqlite:///nexus.db

# PostgreSQL for enterprise/clustered deployments (replaces PostgreSQL JDBC 42.7.2)
# Uncomment the line below and comment out the SQLite line above to use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/nexus

# SQLAlchemy connection pool settings (replaces HikariCP 4.0.3 configuration)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600


# =============================================================================
# Elasticsearch Configuration
# Replaces: Java Elasticsearch Client 2.4.3 (Feature F-103)
# =============================================================================

# Elasticsearch cluster URL for content indexing and search
ELASTICSEARCH_URL=http://localhost:9200

# Prefix for all Nexus index names in Elasticsearch
ELASTICSEARCH_INDEX_PREFIX=nexus_

# Elasticsearch request timeout in seconds
ELASTICSEARCH_TIMEOUT=30


# =============================================================================
# Security - JWT Configuration
# Replaces: Java-JWT 4.4.0 + Apache Shiro 2.0.0 token management
# =============================================================================

# JWT signing key. MUST be changed in production to a random value.
# SECURITY: Key MUST be at least 256 bits (32 bytes / 64 hex chars) for HS256.
#   Shorter keys weaken HMAC security and may be vulnerable to brute-force.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret

# Access token time-to-live in seconds (default: 1 hour)
JWT_ACCESS_TOKEN_EXPIRES=3600

# Refresh token time-to-live in seconds (default: 7 days)
JWT_REFRESH_TOKEN_EXPIRES=604800

# bcrypt hash rounds for password hashing (replaces BouncyCastle 1.78.1)
# Higher values are more secure but slower. Recommended: 12 for production.
PASSWORD_HASH_ROUNDS=12


# =============================================================================
# LDAP Configuration
# Replaces: Apache Shiro LDAP Realm for directory-based authentication
# =============================================================================

# Enable LDAP/Active Directory authentication backend
LDAP_ENABLED=False

# LDAP server connection URL
LDAP_SERVER_URL=ldap://localhost:389

# Bind DN for LDAP search operations
LDAP_BIND_DN=cn=admin,dc=example,dc=com

# Bind password for LDAP search operations (leave empty to prompt or use env)
LDAP_BIND_PASSWORD=

# Base DN for user searches
LDAP_USER_BASE_DN=ou=users,dc=example,dc=com

# Base DN for group searches
LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=com


# =============================================================================
# SSO Configuration
# Replaces: Shiro Security Plugin SAML/OIDC Federation Support
# =============================================================================

# Enable Single Sign-On authentication
SSO_ENABLED=False

# SSO provider type: saml or oidc
SSO_PROVIDER=

# OAuth2/OIDC client identifier
SSO_CLIENT_ID=

# OAuth2/OIDC client secret (keep empty in this template)
SSO_CLIENT_SECRET=

# SSO identity provider issuer URL (e.g., https://idp.example.com/realms/nexus)
SSO_ISSUER_URL=


# =============================================================================
# Storage / BlobStore Configuration
# Replaces: BlobStore API (Feature F-201 File BlobStore, Feature F-202 S3 BlobStore)
# =============================================================================

# BlobStore backend type: "file" for local filesystem, "s3" for Amazon S3
BLOBSTORE_TYPE=file

# Local filesystem path for the File BlobStore (Feature F-201)
# Used when BLOBSTORE_TYPE=file. Supports atomic writes and soft-delete.
BLOBSTORE_PATH=./data/blobs

# --- Amazon S3 BlobStore Settings (Feature F-202) ---
# Required when BLOBSTORE_TYPE=s3. Replaces S3BlobStore.java.

# S3 bucket name for artifact storage
S3_BUCKET=

# AWS region for the S3 bucket
S3_REGION=us-east-1

# AWS access key ID (use IAM roles in production when possible)
S3_ACCESS_KEY_ID=

# AWS secret access key (use IAM roles in production when possible)
S3_SECRET_ACCESS_KEY=

# Custom S3-compatible endpoint URL (e.g., for MinIO, Ceph, or LocalStack)
# Leave empty to use the default AWS S3 endpoint.
S3_ENDPOINT_URL=

# Server-side encryption type: AES256 or aws:kms
S3_ENCRYPTION=AES256


# =============================================================================
# Server Configuration
# Replaces: Eclipse Jetty 12.0.5 embedded HTTP server configuration
# =============================================================================

# Number of Gunicorn worker processes (recommended: 2 * CPU cores + 1)
GUNICORN_WORKERS=4

# Gunicorn bind address and port
GUNICORN_BIND=0.0.0.0:8000

# Worker timeout in seconds (increase for large artifact uploads)
GUNICORN_TIMEOUT=120


# =============================================================================
# Monitoring and Metrics
# Replaces: Dropwizard Metrics 4.2.25 + Prometheus Client 0.16.0 (Feature F-401)
# =============================================================================

# Enable Prometheus metrics collection and export
METRICS_ENABLED=True

# URL path for Prometheus metrics scrape endpoint
METRICS_PATH=/metrics

# URL path for health check endpoint
HEALTH_CHECK_PATH=/api/v1/health


# =============================================================================
# Logging Configuration
# Replaces: SLF4J 1.7.36 + Logback 1.2.13 structured logging
# =============================================================================

# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log output format: "json" for SIEM integration, "standard" for human-readable
LOG_FORMAT=json

# Log file path (ensure the directory exists)
LOG_FILE=logs/nexus.log


# =============================================================================
# Webhook Configuration
# Feature F-503: Webhook Integration for event-driven HTTP POST dispatch
# =============================================================================

# Enable webhook event dispatch
WEBHOOK_ENABLED=True

# HTTP POST timeout for webhook delivery in seconds
WEBHOOK_TIMEOUT=10

# Maximum retry attempts for failed webhook deliveries
WEBHOOK_MAX_RETRIES=3


# =============================================================================
# Proxy Repository Settings
# Replaces: HttpClientFacetImpl.java + Apache HttpClient 4.5.14
# Used by proxy repositories to fetch artifacts from remote upstream registries
# =============================================================================

# HTTP proxy host for outbound connections (leave empty to disable)
HTTP_PROXY_HOST=

# HTTP proxy port
HTTP_PROXY_PORT=

# HTTPS proxy host for outbound TLS connections (leave empty to disable)
HTTPS_PROXY_HOST=

# HTTPS proxy port
HTTPS_PROXY_PORT=

# Comma-separated list of hosts that bypass the proxy
NO_PROXY=localhost,127.0.0.1

# Remote artifact fetch timeout in seconds
PROXY_TIMEOUT=60

# Maximum retry attempts for failed remote fetches
PROXY_MAX_RETRIES=3


# =============================================================================
# CORS Configuration
# Cross-Origin Resource Sharing for frontend integration
# =============================================================================

# Allowed CORS origins. Use specific domains in production (comma-separated).
# Example: CORS_ORIGINS=https://nexus.example.com,https://admin.example.com
CORS_ORIGINS=*


# =============================================================================
# SSL/TLS Configuration
# Feature F-302: SSL/TLS certificate management
# =============================================================================

# Enable SSL/TLS termination at the application level
# Note: In production, SSL is typically terminated at the reverse proxy (Nginx).
SSL_ENABLED=False

# Path to SSL certificate file (PEM format)
SSL_CERT_PATH=

# Path to SSL private key file (PEM format)
SSL_KEY_PATH=


# =============================================================================
# Scheduled Tasks Configuration
# Replaces: Quartz 2.3.2 task scheduler (Feature F-402)
# =============================================================================

# Enable the APScheduler background task scheduler
SCHEDULER_ENABLED=True

# Timezone for scheduled task cron expressions (IANA timezone name)
SCHEDULER_TIMEZONE=UTC


# =============================================================================
# Scripting Configuration
# Feature F-502: Script storage and execution engine
# =============================================================================

# Enable the scripting execution engine
SCRIPTING_ENABLED=True

# Maximum script execution time in seconds (default: 5 minutes)
SCRIPT_MAX_EXECUTION_TIME=300


# =============================================================================
# Plugin Configuration
# Feature F-504: Plugin architecture and extension point framework
# =============================================================================

# Enable the plugin loading system
PLUGINS_ENABLED=True

# Directory path for plugin discovery and loading
PLUGINS_DIRECTORY=./plugins
